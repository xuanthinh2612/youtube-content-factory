# Copy to .env and set the gateway URL, API key, and model IDs.
LLM_BASE_URL=http://host.docker.internal:8000/v1
LLM_API_KEY=change-me
MODEL_FAST=your-fast-model
MODEL_MIDDLE=your-middle-model
MODEL_HARD=your-hard-model

# Fact and News use model-native web search in the Director step.
NATIVE_WEB_SEARCH_MODEL=
NATIVE_WEB_SEARCH_FALLBACK_MODEL=
NATIVE_WEB_SEARCH_MODE=auto
NATIVE_WEB_SEARCH_BASE_URL=
NATIVE_WEB_SEARCH_API_KEY=
NATIVE_WEB_SEARCH_MAX_RESULTS=12
NATIVE_WEB_SEARCH_CONTEXT_SIZE=high
NATIVE_WEB_SEARCH_REQUIRE_CITATIONS=true

ENABLE_MODEL_TIER_FALLBACK=true
LLM_RETRY_ATTEMPTS=2
MAX_LOOP_ROUNDS=2
MAX_CONCURRENT_PROJECTS=2
MAX_CONCURRENT_LLM_CALLS=4

DB_PATH=./data/factory.db
DATA_DIR=./outputs
LOG_LEVEL=INFO
PROJECT_TIMEZONE=Asia/Tokyo
HOST=127.0.0.1
PORT=8090
BIND_ADDRESS=127.0.0.1
